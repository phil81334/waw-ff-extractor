{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaW FF Extractor",
  "version": "0.2.0",
  "identifier": "com.phil81334.waw-ff-extractor",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "WaW FF Extractor",
        "width": 780,
        "height": 780,
        "minWidth": 620,
        "minHeight": 570
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1421; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
